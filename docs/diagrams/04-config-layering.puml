@startuml
!theme plain
skinparam defaultFontSize 13
title 配置解析、指纹与 Skill Lock

actor 用户
participant "CLI / run_configured" as ENTRY
participant ConfigResolver as RESOLVER
collections "Package Config" as PACKAGE
collections "External Config Root" as EXTERNAL
participant "Pydantic Contracts" as VALIDATE
participant "Fingerprint Builder" as HASH
participant "SkillCatalog" as SKILL
participant Orchestrator as ORCH

用户 -> ENTRY : platform + app + task\n[environment] [override]
alt 未指定 config-root
  ENTRY -> PACKAGE : importlib.resources/config
else 指定 config-root
  ENTRY -> EXTERNAL : 外部目录
end

ENTRY -> RESOLVER : resolve selectors
RESOLVER -> RESOLVER : defaults
RESOLVER -> RESOLVER : + platform
RESOLVER -> RESOLVER : + app profile
RESOLVER -> RESOLVER : + task
RESOLVER -> RESOLVER : + environment
RESOLVER -> RESOLVER : + dotted overrides
RESOLVER -> RESOLVER : 校验 selector 身份与路径
RESOLVER -> VALIDATE : AutomationRequest + LoopPlan
VALIDATE --> ENTRY : canonical JSON data
ENTRY -> HASH : config/profile/loop/target/skill lock
HASH --> ENTRY : RunFingerprints

opt skills-root 已提供
  ENTRY -> SKILL : selected platform + lock
  SKILL -> SKILL : 校验必需文件 SHA-256
  alt 缺文件或哈希不匹配
    SKILL --> 用户 : failed（在 UI 前）
  end
end

ENTRY -> ORCH : request + fingerprints
ORCH --> 用户 : planned / succeeded / failed / resume_invalid

note right of RESOLVER
未知路径、schema 错误、selector 改写均拒绝。
operation params 是开放 JSON mapping，
但整个 LoopPlan 仍需通过校验。
end note
@enduml
