@startuml
!theme plain
skinparam defaultFontSize 13
title Midscene UI Agent 第一版架构

package "Interfaces" {
  [Typer CLI] as CLI
  [Python API\nrun / run_configured / resume_run] as API
}

package "Application" {
  [Orchestrator\n依赖构造与图调用] as ORCH
  package "LangGraph" {
    [Automation Graph] as MAIN
    [Single Operation Subgraph] as SINGLE
    [Loop Subgraph] as LOOP
  }
  [Config Node] as CONFNODE
  [Lifecycle / Evidence / Reporting Nodes] as NODES
  [Loop Runtime / Handlers] as SERVICES
  [Test Generation Protocols\nPython & YAML Renderers] as GEN
}

package "Domain" {
  [Automation / Loop Contracts] as CONTRACTS
  [Graph JSON State] as STATE
  [Exit / Retry / Resume Policies] as POLICIES
  [TestCaseSpec / TestStepSpec] as TESTSPEC
}

package "Infrastructure" {
  [Layered Config Resolver] as CONFIG
  database "LangGraph SQLite\nthread_id = run_id" as SQLITE
  [CommandRunner] as RUNNER
  [Evidence Collector] as EVIDENCE
  [Result / Manifest / Native Reports] as REPORTS
  [Skill Lock Catalog] as SKILLS
}

package "Canonical Platforms" {
  [Browser] as WEB
  [Computer] as COMPUTER
  [Android] as ANDROID
  [iOS] as IOS
  [HarmonyOS] as HARMONY
  [Vitest E2E] as VITEST
}

cloud "Official Midscene CLI" {
  [npx @midscene/*@1] as MIDSCENE
}

CLI --> API
API --> CONFNODE : configured request
API --> ORCH : validated request
CONFNODE --> CONFIG
ORCH --> MAIN
MAIN --> SINGLE : route=single
MAIN --> LOOP : route=loop
LOOP --> SERVICES
MAIN --> NODES
MAIN --> SQLITE
SINGLE --> SQLITE
LOOP --> SQLITE
NODES --> EVIDENCE
NODES --> REPORTS
NODES --> SKILLS
ORCH --> WEB
ORCH --> COMPUTER
ORCH --> ANDROID
ORCH --> IOS
ORCH --> HARMONY
ORCH --> VITEST
WEB --> RUNNER
COMPUTER --> RUNNER
ANDROID --> RUNNER
IOS --> RUNNER
HARMONY --> RUNNER
RUNNER --> MIDSCENE
GEN --> TESTSPEC
ORCH --> CONTRACTS
MAIN --> STATE
LOOP --> POLICIES

note bottom of MAIN
prepare_run -> verify_skill_lock
-> execute_route -> finalize_run
end note
@enduml
