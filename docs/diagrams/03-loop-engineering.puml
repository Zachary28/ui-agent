@startuml
!theme plain
skinparam defaultFontSize 13
title Loop Engineering 执行、中断与恢复

actor 用户
participant Orchestrator as ORCH
participant "Automation Graph" as MAIN
participant "Loop Subgraph" as LOOP
participant Scheduler as SCHED
participant Selector as SELECT
participant "Loop Runtime / Handler" as RUNTIME
participant PlatformAdapter as ADAPTER
participant ExitPolicy as EXIT
database "LangGraph SQLite" as DB

用户 -> ORCH : run(request.loop, run_id)
ORCH -> MAIN : invoke(initial state)
MAIN -> LOOP : execute_route(plan)

loop 每个 tick
  LOOP -> ADAPTER : observe UI
  ADAPTER --> LOOP : reachable/fingerprint/message
  LOOP -> SCHED : 计算 interval/startup/popup/ad/stall/runtime/after_operation
  SCHED --> LOOP : due_operations
  LOOP -> SELECT : 按 priority 与运行状态选择
  SELECT --> LOOP : operation + stable operation_id
  LOOP -> DB : checkpoint before execute
  LOOP -> RUNTIME : execute(operation, timeout, attempt)
  RUNTIME -> ADAPTER : Midscene prompt/command
  ADAPTER --> RUNTIME : outcome
  RUNTIME --> LOOP : succeeded/reason/artifacts
  LOOP -> EXIT : 计数、失败、无进展、阻塞、取消
  EXIT --> LOOP : continue / retry / exit
  LOOP -> DB : checkpoint after evaluation
end

alt 进程在操作前后中断
  用户 -> ORCH : run --resume same_run_id
  ORCH -> DB : 读取 request + fingerprints
  ORCH -> ORCH : 比较 config/profile/loop/skill/target
  alt 指纹不匹配
    ORCH --> 用户 : resume_invalid（不连接 UI）
  else 指纹匹配
    ORCH -> MAIN : invoke(None)
    MAIN -> LOOP : 恢复 pending state
    alt 非幂等操作可能已生效
      LOOP -> ADAPTER : verify_effect(operation_id)
      ADAPTER --> LOOP : effect_exists
      LOOP -> LOOP : complete 或 retry
    end
  end
end

LOOP --> MAIN : loop_summary + exit_reason
MAIN -> ADAPTER : disconnect/close
MAIN --> 用户 : result + evidence + reports
@enduml
