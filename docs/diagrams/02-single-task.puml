@startuml
!theme plain
skinparam defaultFontSize 13
title 单操作任务与报告时序

actor 用户
participant CLI
participant "Config/API" as API
participant Orchestrator as ORCH
participant "Automation Graph" as MAIN
participant "Single Operation Subgraph" as SINGLE
participant PlatformAdapter as ADAPTER
participant CommandRunner as RUNNER
participant "Midscene CLI" as MIDSCENE
database "langgraph.sqlite" as DB
participant "Evidence / Reports" as REPORT

用户 -> CLI : run --platform ... [--app --task]
CLI -> API : 解析参数与分层配置
API -> ORCH : AutomationRequest + fingerprints

alt mode = plan
  ORCH -> REPORT : 写 plan.json/result/manifest
  ORCH --> 用户 : planned
else mode = live
  ORCH -> MAIN : invoke(state, thread_id=run_id)
  MAIN -> DB : checkpoint prepare_run
  MAIN -> MAIN : verify_skill_lock
  alt lock 不匹配
    MAIN -> REPORT : finalize failed
    MAIN --> 用户 : failed（未连接 UI）
  else lock 有效
    MAIN -> SINGLE : execute_route
    loop 操作序列
      SINGLE -> REPORT : before evidence
      SINGLE -> ADAPTER : command(request, operation)
      ADAPTER -> RUNNER : CommandSpec
      RUNNER -> MIDSCENE : npx -y @midscene/...@1
      MIDSCENE --> RUNNER : returncode/stdout/stderr
      RUNNER --> SINGLE : CommandResult
      SINGLE -> REPORT : after evidence
      SINGLE -> DB : 操作状态 checkpoint
    end
    SINGLE --> MAIN : succeeded/failed + steps
    MAIN -> ADAPTER : release（按退出配置）
    MAIN -> REPORT : result.json + manifest.json + native report
    MAIN -> DB : finalize_run checkpoint
    MAIN --> 用户 : AutomationResult
  end
end
@enduml
